{
  "family": "physical-fitness-backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::164675011147:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "physical-fitness-backend",
      "image": "164675011147.dkr.ecr.us-east-2.amazonaws.com/physical-fitness-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5005,
          "hostPort": 5005,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "ASPNETCORE_ENVIRONMENT",
          "value": "Production"
        },
        {
          "name": "ASPNETCORE_URLS",
          "value": "http://+:5005"
        },
        {
          "name": "ConnectionStrings__DefaultConnection",
          "value": "Host=ep-divine-dream-bcf0vfoq.c-16.us-east-1.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=npg_zmic9U4dRwLr;SSL Mode=Require;Trust Server Certificate=true;"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/physical-fitness-backend",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
